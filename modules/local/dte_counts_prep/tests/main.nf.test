nextflow_process {

    name "Test Process DTE_COUNTS_PREP"
    script "../main.nf"
    process "DTE_COUNTS_PREP"

    tag "modules"
    tag "modules_local"
    tag "dte_counts_prep"

    test("stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id: 'cohort' ],
                    file('orf_psite_counts.tsv'),
                    file('gene_counts.tsv'),
                    file('orf_to_gene.tsv'),
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
