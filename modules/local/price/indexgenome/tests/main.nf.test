nextflow_process {

    name "Test Process PRICE_INDEXGENOME"
    script "../main.nf"
    process "PRICE_INDEXGENOME"

    tag "modules"
    tag "modules_local"
    tag "price"
    tag "price_indexgenome"

    test("synthetic data - stub") {
        options "-stub-run"

        when {
            process {
                """
                def fasta  = file('genome.fa')
                fasta.text = ">chr1\\nACGT\\n"
                def gtf    = file('genome.gtf')
                gtf.text   = ""

                input[0] = Channel.of([ [id:'reference'], fasta, gtf ])
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
