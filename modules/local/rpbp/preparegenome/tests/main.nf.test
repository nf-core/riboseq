nextflow_process {

    name "Test Process RPBP_PREPAREGENOME"
    script "../main.nf"
    process "RPBP_PREPAREGENOME"

    tag "modules"
    tag "modules_local"
    tag "rpbp"
    tag "rpbp_preparegenome"

    test("synthetic data - stub") {
        options "-stub-run"

        when {
            process {
                """
                def fasta  = file('genome.fa')
                fasta.text = ">chr1\\nACGT\\n"
                def gtf    = file('genome.gtf')
                gtf.text   = ""
                def cfg    = file('rpbp_config.yaml')
                cfg.text   = ""

                input[0] = Channel.of([ [id:'reference'], fasta, gtf, cfg ])
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
