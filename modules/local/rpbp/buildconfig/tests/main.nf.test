nextflow_process {

    name "Test Process RPBP_BUILDCONFIG"
    script "../main.nf"
    process "RPBP_BUILDCONFIG"

    tag "modules"
    tag "modules_local"
    tag "rpbp"
    tag "rpbp_buildconfig"

    test("synthetic data - render config") {
        when {
            process {
                """
                def fasta = file('genome.fa')
                fasta.text = ">chr1\\nACGTACGT\\n"
                def gtf = file('genome.gtf')
                gtf.text = "chr1\\ttest\\texon\\t1\\t8\\t.\\t+\\t.\\tgene_id \\"g1\\";\\n"

                input[0] = Channel.of([ [id:'reference'], fasta, gtf ])
                input[1] = 'reference'
                input[2] = ''
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert file(process.out.config[0][1]).name == 'rpbp_config.yaml' }
            )
        }
    }

    test("synthetic data - stub") {
        options "-stub-run"

        when {
            process {
                """
                def fasta = file('genome.fa')
                fasta.text = ">chr1\\n"
                def gtf = file('genome.gtf')
                gtf.text = ""

                input[0] = Channel.of([ [id:'reference'], fasta, gtf ])
                input[1] = 'reference'
                input[2] = ''
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
