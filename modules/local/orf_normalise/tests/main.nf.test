nextflow_process {

    name "Test Process ORF_NORMALISE"
    script "../main.nf"
    process "ORF_NORMALISE"

    tag "modules"
    tag "modules_local"
    tag "orf_normalise"

    test("ribocode - stub") {
        options "-stub-run"

        when {
            process {
                """
                def orfs = file('sample_X.txt')
                orfs.text = ""
                def gtf = file('reference.gtf')
                gtf.text = ""

                input[0] = Channel.of([ [id:'sample_X', caller:'ribocode'], orfs ])
                input[1] = Channel.of([ [id:'reference'], gtf ])
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }

    test("ribotish - stub") {
