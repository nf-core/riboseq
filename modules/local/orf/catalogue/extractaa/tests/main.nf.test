nextflow_process {

    name "Test Process ORF_CATALOGUE_EXTRACTAA"
    script "../main.nf"
    process "ORF_CATALOGUE_EXTRACTAA"

    tag "modules"
    tag "modules_local"
    tag "orf_catalogue"
    tag "orf_catalogue_extractaa"

    test("synthetic data - stub") {
        options "-stub-run"

        when {
            process {
                """
                def bed = file('orf_catalogue.bed12')
                bed.text = ""
                def fasta = file('genome.fa')
                fasta.text = ""

                input[0] = Channel.of([ [id:'allsamples'], bed ])
                input[1] = Channel.of([ [id:'reference'], fasta ])
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
