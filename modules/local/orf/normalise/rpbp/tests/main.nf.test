nextflow_process {

    name "Test Process ORF_NORMALISE_RPBP"
    script "../main.nf"
    process "ORF_NORMALISE_RPBP"

    tag "modules"
    tag "modules_local"
    tag "orf_normalise"
    tag "orf_normalise_rpbp"

    test("synthetic data - stub") {
        options "-stub-run"

        when {
            process {
                """
                def orfs = file('sample_X.predicted-orfs.bed.gz')
                orfs.text = ""
                def gtf = file('reference.gtf')
                gtf.text = ""

                input[0] = Channel.of([ [id:'sample_X'], orfs ])
                input[1] = Channel.of([ [id:'reference'], gtf ])
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
