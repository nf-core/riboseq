nextflow_process {

    name "Test Process ORF_NORMALISE_RIBOTISH"
    script "../main.nf"
    process "ORF_NORMALISE_RIBOTISH"

    tag "modules"
    tag "modules_local"
    tag "orf_normalise"
    tag "orf_normalise_ribotish"

    test("synthetic data - stub") {
        options "-stub-run"

        when {
            process {
                """
                def pred = file('sample_X_pred.txt')
                pred.text = ""
                def gtf = file('reference.gtf')
                gtf.text = ""

                input[0] = Channel.of([ [id:'sample_X'], pred ])
                input[1] = Channel.of([ [id:'reference'], gtf ])
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
