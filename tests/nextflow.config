/*
========================================================================================
    Nextflow config file for running nf-test tests
========================================================================================
*/

params {
    pipelines_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/riboseq/'
    modules_testdata_base_path = 's3://ngi-igenomes/testdata/nf-core/modules/'
}

aws.client.anonymous = true // fixes S3 access issues on self-hosted runners

process {

    // Override modules.config so module snapshots match

    withName: GFFREAD {
        ext.args = null
    }

    //
    // Snapshot stability: add seeds and deterministic ordering to production args
    //

    withName: RIBODETECTOR {
        ext.args = '-e rrna --seed 1'
        cpus = 1
    }

    withName: BOWTIE2_ALIGN {
        ext.args = { "--very-sensitive-local --un-gz ${meta.id}.non_rRNA.fastq.gz --seed 1 --reorder" }
    }

    withName: BOWTIE2_ALIGN_PE {
        ext.args = '--very-sensitive-local --seed 1 --reorder'
    }

    withName: 'RIBOTISH.*' {
        cpus = 1
    }
}
