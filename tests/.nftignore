.DS_Store

# STAR alignment: BAMs/indices are large binaries; .bam.stats and the STAR
# *.Log.* files carry per-run timings. Genome alignment counts themselves are
# deterministic (verified) and reach snapshots via downstream count tables.
alignment/star/**/*.bam.stats
alignment/star/**/*.{bam,bam.bai}
alignment/star/deduplicated/umicollapse/*_UMICollapse.log
alignment/star/log/*.Log.{final.out,out,progress.out}

# Hybrid second-pass STAR (extended ORF analysis): non-deterministic. Aligning
# Ribo-seq reads to the redundant canonical+novel transcriptome yields
# thread-order-dependent multimapper assignment; verified that even Log.final.out
# and per-transcript idxstats differ run-to-run, and STAR's fixed RNG seed does
# not remove it. Consumed only by RiboCode (a reproducibility caveat for novel
# ORF calling, not the default path).
hybrid_star/log/*.Log.{final.out,out,progress.out}
hybrid_star/log/SRX*.hybrid.SJ.out.tab
hybrid_star/original/**
hybrid_star/sorted/**

# StringTie per-sample de novo assembly is non-deterministic (multithreaded);
# the merged hybrid_reference.gtf it feeds IS deterministic and is snapshotted.
stringtie/SRX*.denovo.transcripts.gtf
stringtie/gffcompare/**

# ORF-level combined counts are keyed by orf_id; ordering is deterministic once
# orfmerge sorts the catalogue, but kept excluded pending confirmation.
dte/orf_level/orf_combined_counts.tsv

# MultiQC: reports/plots are HTML/SVG/PDF/parquet/JSON binaries or carry run
# metadata and timestamps; the *_general_stats / data.json aggregates also fold
# in the non-deterministic hybrid-STAR sample stats under extended analysis.
multiqc/multiqc_plots/{svg,pdf,png}/*.{svg,pdf,png}
multiqc/multiqc_report.html
multiqc/star/multiqc.log
multiqc/star/multiqc_general_stats.txt
multiqc/star/multiqc_report.html
multiqc/star/multiqc_report_data/fastqc-1_top_overrepresented_sequences_table.txt
multiqc/star/multiqc_report_data/fastqc_top_overrepresented_sequences_table.txt
multiqc/star/multiqc_report_data/llms-full.txt
multiqc/star/multiqc_report_data/multiqc.log
multiqc/star/multiqc_report_data/multiqc.parquet
multiqc/star/multiqc_report_data/multiqc_data.json
multiqc/star/multiqc_report_data/multiqc_general_stats.txt
multiqc/star/multiqc_report_data/multiqc_software_versions.txt
multiqc/star/multiqc_report_data/multiqc_salmon.txt
multiqc/star/multiqc_report_data/multiqc_salmon_salmon-1.txt
multiqc/star/multiqc_report_data/multiqc_sortmerna.txt
multiqc/star/multiqc_report_data/multiqc_sources.txt
multiqc/star/multiqc_report_data/salmon_plot.txt
multiqc/star/multiqc_report_data/sortmerna-detailed-plot.txt
multiqc/star/multiqc_report_plots/{svg,pdf,png}/*.{svg,pdf,png}

# Pipeline run reports: timestamps, durations, session ids.
pipeline_info/*.{html,json,txt,yml}

# QC/preprocessing logs and FastQC archives carry timestamps and version strings.
preprocessing/fastqc/*_fastqc.{html,zip}
preprocessing/fq_lint/**/*.fq_lint.txt
preprocessing/sortmerna/*.sortmerna.log
preprocessing/trimgalore/*.fastq.gz_trimming_report.txt
preprocessing/trimgalore/fastqc/*_fastqc.{html,zip}
preprocessing/umitools/*.umi_extract.log

# Salmon: multithreaded EM gives run-to-run quant differences (verified quant.sf
# / quant.genes.sf differ); .rds are binaries; logs/meta carry timestamps.
quantification/salmon/*/aux_info/ambig_info.tsv
quantification/salmon/*/aux_info/expected_bias.gz
quantification/salmon/*/aux_info/fld.gz
quantification/salmon/*/aux_info/meta_info.json
quantification/salmon/*/libParams/flenDist.txt
quantification/salmon/*/logs/salmon_quant.log
quantification/salmon/*/quant.genes.sf
quantification/salmon/*/quant.sf
quantification/salmon/salmon.merged.gene.SummarizedExperiment.rds
quantification/salmon/salmon.merged.gene.length_scaled.SummarizedExperiment.rds
quantification/salmon/salmon.merged.gene.scaled.SummarizedExperiment.rds
quantification/salmon/*.rds
quantification/salmon/**/*.rds
quantification/salmon/salmon.merged.gene_counts.tsv
quantification/salmon/salmon.merged.gene_counts_length_scaled.tsv
quantification/salmon/salmon.merged.gene_counts_scaled.tsv
quantification/salmon/salmon.merged.gene_lengths.tsv
quantification/salmon/salmon.merged.gene_tpm.tsv
quantification/salmon/salmon.merged.transcript.SummarizedExperiment.rds
quantification/salmon/salmon.merged.transcript_counts.tsv
quantification/salmon/salmon.merged.transcript_lengths.tsv
quantification/salmon/salmon.merged.transcript_tpm.tsv
quantification/salmon_te_pseudo/*/aux_info/expected_bias.gz
quantification/salmon_te_pseudo/*/aux_info/fld.gz
quantification/salmon_te_pseudo/*/aux_info/meta_info.json
quantification/salmon_te_pseudo/*/libParams/flenDist.txt
quantification/salmon_te_pseudo/*/logs/salmon_quant.log
quantification/salmon_te_pseudo/*/quant.genes.sf
quantification/salmon_te_pseudo/*/quant.sf
quantification/salmon_te_pseudo/*.rds
quantification/salmon_te_pseudo/**/*.rds
quantification/salmon_te_pseudo/salmon.merged.te_pseudo.*.tsv

# In-frame P-site gene counts: raw integer counts are deterministic (verified);
# the normalised column carries sub-0.1% floating-point jitter from parallel
# summation. Data is asserted in the quantify_inframe_psite_plastid module test.
quantification/inframe_psite/*

# Plot PDFs: rendering (fonts, timestamps) is non-deterministic.
riboseq_qc/ribotish/*_qual.pdf
psites/ribowaltz/**/*.pdf

# Plastid offsets/metagene/bedgraph: data is deterministic but every file carries
# a `## date = ...` header. Asserted (date-stripped) at module level.
psites/plastid/*/*

# anota2seq / DOTSeq: R-based fitting uses stochastic simulation (RVM, dfbetas);
# results and .rds differ run-to-run. deltate (DESeq2) emits R session logs.
translational_efficiency/anota2seq/**
translational_efficiency/deltate/**
dte/orf_level/anota2seq/**
dte/orf_level/dotseq/**
translational_efficiency/deltate/*.{translation,translated_mRNA,total_mRNA}.deltate.results.tsv

# R session logs: package versions, timestamps.
**/*R_sessionInfo.log
