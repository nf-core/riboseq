nextflow_pipeline {

    name "Test pipeline with StringTie assembly + --extended_orf_analysis"
    script "../main.nf"
    tag "pipeline"
    tag "pipeline_riboseq"
    tag "stringtie"
    tag "extended_orf_analysis"

    test("-profile test --skip_stringtie false --extended_orf_analysis true") {

        when {
            params {
                outdir                  = "$outputDir"
                skip_stringtie          = false
                extended_orf_analysis   = true
                // run_ribotricer left at default false: see comment in
                // tests/novel_gtf.nf.test — chr20 test data is too sparse
                // for ribotricer's periodicity inference.
            }
        }

        then {
            // stable_name: All files + folders in ${params.outdir}/ with a stable name
            def stable_name = getAllFilesFromDir(params.outdir, relative: true, includeDir: true, ignore: ['pipeline_info/*.{html,json,txt}'])
            // stable_path: All files in ${params.outdir}/ with stable content
            def stable_path = getAllFilesFromDir(params.outdir, ignoreFile: 'tests/.nftignore_orf')

            def hybrid_gtf            = file("${params.outdir}/stringtie/hybrid_reference.gtf")
            def ribotish_pred_all     = file("${params.outdir}/orf_predictions/ribotish_all/allsamples_pred.txt")

            // An ORF whose gene id is missing from the RNA-seq matrix is
            // dropped from the ORF-level DTE join without an error.
            def orf_to_gene = file("${params.outdir}/orf_catalogue/cohort.catalogue.orf_to_gene.tsv").readLines()
            def catalogue_genes = orf_to_gene.drop(1)
                .collect { it.split('\t', -1)[1] }
                .findAll { it }
                .unique()
            def rna_genes = file("${params.outdir}/quantification/salmon_hybrid/salmon.merged.hybrid.gene_counts_length_scaled.tsv")
                .readLines()
                .drop(1)
                .collect { it.split('\t')[0] }
                .toSet()

            assertAll(
                { assert workflow.success},
                { assert hybrid_gtf.exists() && hybrid_gtf.size() > 0 },
                { assert hybrid_gtf.readLines().count { line -> line.contains('class_code "u"') } > 0 },
                { assert hybrid_gtf.readLines().every { line -> !line.contains('class_code') || line.contains('class_code "u"') } },
                { assert ribotish_pred_all.exists() && ribotish_pred_all.size() > 0 },
                { assert catalogue_genes.size() > 0 },
                { assert catalogue_genes.every { rna_genes.contains(it) } },
                { assert snapshot(
                    // pipeline versions.yml file for multiqc from which Nextflow version is removed because we test pipelines on multiple Nextflow versions
                    removeNextflowVersion("$outputDir/pipeline_info/nf_core_riboseq_software_mqc_versions.yml"),
                    // All stable path name, with a relative path
                    stable_name,
                    // All files with stable contents
                    stable_path
                ).match() }
            )
        }

        cleanup {
            if (System.getenv("NFT_PROFILE")?.contains("docker")) {
                "docker system prune -a -f --volumes".execute()
            }
            new File("${launchDir}").deleteDir()
        }
    }
}
