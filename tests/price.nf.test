nextflow_pipeline {

    name "Test pipeline with PRICE enabled (--run_price true)"
    script "../main.nf"
    tag "pipeline"
    tag "pipeline_riboseq"
    tag "price"

    test("-profile test --run_price true") {

        when {
            params {
                outdir     = "$outputDir"
                run_price  = true
                // skip_stringtie left at default true: PRICE doesn't depend
                // on StringTie. Extended-mode wiring is covered separately
                // by tests/stringtie_extended.nf.test.
            }
        }

        then {
            def stable_name = getAllFilesFromDir(params.outdir, relative: true, includeDir: true, ignore: ['pipeline_info/*.{html,json,txt}'])
            def stable_path = getAllFilesFromDir(params.outdir, ignoreFile: 'tests/.nftignore')

            def price_orfs_tsv = file("${params.outdir}/price/allsamples.orfs.tsv")
            def price_index    = file("${params.outdir}/price/index/reference.oml")
            assertAll(
                { assert workflow.success },
                { assert price_index.exists() && price_index.size() > 0 },
                { assert price_orfs_tsv.exists() },
                { assert snapshot(
                    removeNextflowVersion("$outputDir/pipeline_info/nf_core_riboseq_software_mqc_versions.yml"),
                    stable_name,
                    stable_path
                ).match() }
            )
        }

        cleanup {
            if (System.getenv("NFT_PROFILE")?.contains("docker")) {
                "docker system prune -f".execute()
            }
            new File("${launchDir}").deleteDir()
        }
    }
}
