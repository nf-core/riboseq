nextflow_workflow {

    name "Test hybrid UMI alias configuration"
    script "tests/umi_alias_config.nf"
    workflow "UMI_ALIAS_CONFIG"

    tag "subworkflows"
    tag "subworkflows/bam_dedup_umi"
    tag "umi"

    test("BAM_DEDUP_UMI hybrid aliases") {

        when {
            params {
                outdir = "$outputDir"
            }
            workflow {
                """
                input[0] = [
                    [ id:'test' ],
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/bam/test.paired_end.umi.sorted.bam', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/bam/test.paired_end.umi.sorted.bam.bai', checkIfExists: true)
                ]
                input[1] = [
                    [ id:'genome' ],
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta.fai', checkIfExists: true)
                ]
                input[2] = 'umitools'
                input[3] = false
                input[4] = [
                    [ id:'test' ],
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/bam/test.paired_end.umi.sorted.bam', checkIfExists: true)
                ]
                input[5] = [
                    [ id:'genome' ],
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/transcriptome.fasta', checkIfExists: true),
                    []
                ]
                input[6] = false
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(
                    file(workflow.out.hybrid_transcriptome_bam[0][1]).name,
                    file(workflow.out.hybrid_transcriptome_dedup_bam[0][1]).name,
                    file(workflow.out.hybrid_transcriptome_sorted_bam[0][1]).name,
                    file(workflow.out.hybrid_transcriptome_filtered_bam[0][1]).name,
                    file(workflow.out.rna_transcriptome_bam[0][1]).name,
                    file(workflow.out.rna_transcriptome_dedup_bam[0][1]).name,
                    file(workflow.out.rna_transcriptome_sorted_bam[0][1]).name,
                    file(workflow.out.rna_transcriptome_filtered_bam[0][1]).name,
                    bam(workflow.out.hybrid_transcriptome_sorted_bam[0][1]).getReadsMD5(),
                    bam(workflow.out.rna_transcriptome_sorted_bam[0][1]).getReadsMD5()
                ).match() }
            )
        }
    }
}
